{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["email", "password_hash", "role", "created_at"],
    "properties": {
      "email": {"bsonType": "string", "description": "must be a string and is required"},
      "password_hash": {"bsonType": "string", "description": "must be a hash string"},
      "role": {"enum": ["teacher", "student"], "description": "must be teacher or student"},
      "created_at": {"bsonType": "date"}
    }
  }
}
